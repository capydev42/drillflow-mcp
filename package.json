  "description": "MCP server for DrillFlow — publish drill-down diagrams from an agent and read them back.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "drillflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "drillflow",
    "diagram",
    "mermaid",
    "flowchart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capydev42/drillflow-mcp.git"
  },
  "homepage": "https://drillflow.de",
  "scripts": {

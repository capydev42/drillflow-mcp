    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
}
